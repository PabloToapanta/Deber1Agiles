
@article{alvarez-pineda_implementacion_2026,
	title = {Implementación de accesibilidad web según {WCAG} 2.1: perceptibilidad},
	copyright = {Copyright (c) 2026 Universidad Politécnica Salesiana},
	issn = {1390-860X},
	shorttitle = {Implementación de accesibilidad web según {WCAG} 2.1},
	url = {https://ingenius.ups.edu.ec/ingenius/article/view/11235},
	doi = {10.17163/ings.n36.2026.06},
	abstract = {The university web platform intended for individuals with visual impairments had significant accessibility limitations that restricted independent use. This Integrative Project aimed to implement the perceivability principle of the WCAG 2.1 standard, at conformance level AA, using the agile Rapid Application Development (RAD) methodology, which enabled rapid iterations of design, development, evaluation, and improvement. The main deficiencies identified included the absence of text alternatives, insufficient color contrast, poorly descriptive labels, and inadequate semantic structure. These issues were addressed by incorporating descriptive alt attributes, aria-label attributes, a hierarchical HTML5 structure, and CSS enhancements to improve visibility, focus indication, and keyboard navigation. The evaluation combined automated assessment using TAW, manual testing with the NVDA screen reader, and direct validation with users with visual impairments through Likert-type surveys. Quantitative results showed improvements of more than 2 points across all indicators, reaching scores above 4.4 out of 5, compared with the initial version, which did not exceed 2.5. Qualitative findings revealed a clearer, more structured, and more accessible user experience, with greater ease in identifying interface elements, navigating the platform, and using assistive technologies. These findings demonstrate that applying the perceivability principle not only fulfills the technical requirements of WCAG 2.1 but also has a tangible positive impact on digital inclusion and on the user experience of individuals with visual impairments.},
	language = {es},
	number = {36},
	urldate = {2026-08-19},
	journal = {Ingenius},
	author = {Álvarez-Pineda, Francisco and Urrego-Gómez, Yovin and Ordóñez-Ordóñez, Pablo and Torres-Carrión, Hernán},
	month = jul,
	year = {2026},
	keywords = {accesibilidad web, accessibility assessment, discapacidad visual, evaluación de accesibilidad, metodología RAD, perceptibilidad, perceptibility, RAD methodology, visual impairment, WCAG 2.1, web accessibility},
	pages = {70--83},
	file = {Full Text PDF:/home/pablo/Zotero/storage/SAT6P72X/Álvarez-Pineda et al. - 2026 - Implementación de accesibilidad web según WCAG 2.1 perceptibilidad.pdf:application/pdf},
}

@article{purnamasari_rapid_2026,
	series = {The {Eighth} {Information} {Systems} {International} {Conference}},
	title = {Rapid {Application} {Development} of warehouse management system for leathercraft industry},
	volume = {284},
	issn = {1877-0509},
	url = {https://www.sciencedirect.com/science/article/pii/S1877050926022982},
	doi = {10.1016/j.procs.2026.07.010},
	abstract = {This paper details the systematic Rapid Application Development (RAD) of a web-based Warehouse Management System (WMS) for the leathercraft industry, employing comprehensive requirement elicitation, iterative prototyping, and Grey-box testing methodologies. The research addresses operational challenges, including diverse product dimensions, complex inventory tracking, and manual-to-digital transition complexities through structured stakeholder engagement and systematic usability testing. User Acceptance Testing confirmed system effectiveness across inventory management, production tracking, and reporting functionalities. The study demonstrates RAD’s capacity to develop tailored solutions for niche industries, providing a systematic framework for industry-specific WMS development and evidence-based recommendations for digital transformation in traditional craft industries.},
	urldate = {2026-08-19},
	journal = {Procedia Computer Science},
	author = {Purnamasari, Dian I. and Permadi, Vynska A. and Agusdin, Riza P. and Perwira, Rifki I.},
	month = jan,
	year = {2026},
	keywords = {Inventory Management, Leathercraft industry, Production Management, Rapid Application Development (RAD), Warehouse Management System (WMS)},
	pages = {338--346},
	file = {ScienceDirect Full Text PDF:/home/pablo/Zotero/storage/WER47VCJ/Purnamasari et al. - 2026 - Rapid Application Development of warehouse management system for leathercraft industry.pdf:application/pdf;ScienceDirect Snapshot:/home/pablo/Zotero/storage/Z4BVU9VG/S1877050926022982.html:text/html},
}

@article{radvilaite_integrating_2025,
	title = {Integrating {Rapid} {Application} {Development} {Courses} into {Higher} {Education} {Curricula}},
	volume = {15},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2076-3417},
	url = {https://www.mdpi.com/2076-3417/15/6/3323},
	doi = {10.3390/app15063323},
	abstract = {As the development of technology and business improvement is rapidly advancing these days, higher education (HE) should continually provide and develop up-to-date knowledge and skills for students. This is crucial for training competitive specialists, addressing digital transformation and enhancing digital readiness of HE institutions, as well as increasing students’ employment opportunities. Therefore, this paper explores the development and implementation of the new courses for teaching Rapid Application Development (RAD) on the Oracle Application Express platform at five European universities. Consequently, a new and flexible methodology for the integration of developed courses into existing study programs with different integration strategies is proposed and implemented. The effectiveness of the courses’ integration, implementation and students’ satisfaction were evaluated using Kirkpatrick’s model. The results reveal that students’ knowledge of RAD increased after completing the courses, which can improve students’ employment opportunities and promote digital transformation in HE institutions and studies. In addition, a majority of the students expressed positive feedback for both modules, finding the courses relevant, well delivered and motivating for future study. This study and its results are expected to inspire researchers, teachers and practitioners for further work towards the digital transformation of HE and offer valuable insights for future HE digitalization and research.},
	language = {en},
	number = {6},
	urldate = {2026-08-19},
	journal = {Applied Sciences},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Radvilaitė, Urtė and Kalibatienė, Diana},
	month = jan,
	year = {2025},
	keywords = {database, digital transformation, higher education, Kirkpatrick’s model, knowledge evaluation, rapid application development},
	pages = {3323},
	file = {Full Text PDF:/home/pablo/Zotero/storage/LEATS57P/Radvilaitė and Kalibatienė - 2025 - Integrating Rapid Application Development Courses into Higher Education Curricula.pdf:application/pdf},
}

@article{piray-rodriguez_alisis_2025,
	title = {Análisis de la normativa relacionada con seguridad y privacidad de datos personales en universidades ecuatorianas [{Analysis} of regulations related to data security and privacy in {Ecuadorian} universities]},
	volume = {4},
	copyright = {Derechos de autor 2025 Paúl Orlando Piray-Rodríguez , Bolívar David Narváez-Montenegro, Leonardo Mario Falconí-Cárdenas, Edison Joselito Naranjo-Luzuriaga (Autor/a)},
	issn = {3028-872X},
	url = {https://revistasinstitutoperspectivasglobales.org/index.php/verdadyderecho/article/view/735},
	doi = {10.62574/hw9fjp32},
	abstract = {Este análisis aborda la protección de datos personales en instituciones de educación superior ecuatorianas, tema crucial dado el manejo masivo de información sensible de estudiantes, docentes y personal administrativo. El objetivo principal fue evaluar el marco normativo vigente que regula esta materia en universidades ecuatorianas. Se empleó metodología cualitativa, documental y descriptiva, desarrollando análisis exhaustivo de leyes, reglamentos, resoluciones y políticas institucionales vigentes hasta marzo de 2025. Los resultados revelan un marco normativo robusto pero fragmentado, encabezado por la Constitución, la Ley Orgánica de Protección de Datos Personales y su reglamento, complementado por regulaciones adicionales aún no completamente implementadas por las instituciones universitarias. Se identificó carencia de procedimientos institucionales claros para obtención de consentimiento, gestión de derechos y prevención de brechas de seguridad. El estudio concluye que resulta fundamental fortalecer capacidades técnicas y organizacionales universitarias para asegurar cumplimiento normativo y protección efectiva de derechos comunitarios.},
	language = {es},
	number = {CCGECON},
	urldate = {2026-08-22},
	journal = {Verdad y Derecho. Revista Arbitrada de Ciencias Jurídicas y Sociales},
	author = {Piray-Rodríguez, Paúl Orlando and Narváez-Montenegro, Bolívar David and Falconí-Cárdenas, Leonardo Mario and Naranjo-Luzuriaga, Edison Joselito},
	month = aug,
	year = {2025},
	keywords = {(Fuente: Tesauro UNESCO)., (Source: UNESCO Thesaurus)., data protection, privacidad, privacy, protección de datos, universidades, universities},
	pages = {293--312},
	file = {Full Text PDF:/home/pablo/Zotero/storage/KC7C2LLE/Piray-Rodríguez et al. - 2025 - Análisis de la normativa relacionada con seguridad y privacidad de datos personales en universidades.pdf:application/pdf},
}

@article{alvarez-carrion_proteccion_2024,
	title = {Protección de {Datos} {Personales} en {Plataformas} {Educativas} {Digitales} en el {Sistema} de {Educación} {Superior} de {Ecuador}},
	volume = {8},
	issn = {2588-0659},
	url = {https://www.investigarmqr.com/ojs/index.php/mqr/article/view/1760},
	doi = {10.56048/MQR20225.8.3.2024.5324-5339},
	abstract = {The digitalization of Ecuador’s higher education system has driven the widespread use of digital educational platforms, resulting in the extensive management of personal data from students and academic staff. This study assesses the effectiveness of the Organic Law on Personal Data Protection (LOPDP), enacted in 2021, in safeguarding this sensitive information. While the law provides a strong legal framework, its implementation faces significant challenges, including inadequate infrastructure and the need for enhanced cybersecurity training. Through the analysis of documented data breaches in Ecuadorian universities, technical failures and human errors were identified as the primary causes, underscoring the importance of fostering an organizational culture focused on information security. Furthermore, comparisons with international regulatory frameworks, such as the General Data Protection Regulation (GDPR), suggest that adopting best practices like privacy by design could strengthen data protection in the educational sector. Recommendations include increased investment in advanced technology, the implementation of rigorous security policies, and the regular conduct of security audits to ensure the effective protection of personal data. This study provides a comprehensive overview of the current state of data protection in Ecuadorian higher education and offers guidelines for improving information security within educational institutions},
	language = {es},
	number = {3},
	urldate = {2026-08-22},
	journal = {MQRInvestigar},
	author = {Álvarez-Carrión, Jenniffer Adriana and Hernández--Sotomayor, Gabriel Paul},
	month = sep,
	year = {2024},
	keywords = {Ciberseguridad, Ecuador, Educación superior, Plataformas digitales, Protección de datos},
	pages = {5324--5339},
	file = {Full Text PDF:/home/pablo/Zotero/storage/759PKP57/Álvarez-Carrión and Hernández--Sotomayor - 2024 - Protección de Datos Personales en Plataformas Educativas Digitales en el Sistema de Educación Superi.pdf:application/pdf},
}
